# ARGUS environment configuration
# Copy to .env and fill in. Never commit .env.

# ---------- App ----------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ---------- PostgreSQL ----------
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus_dev_password
POSTGRES_DB=argus
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://argus:argus_dev_password@localhost:5432/argus
# Seconds to wait for a Postgres connection before reporting it down
DB_CONNECT_TIMEOUT=5

# ---------- Neo4j ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=argus_dev_password
NEO4J_DATABASE=neo4j

# ---------- Qdrant ----------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=argus_code_chunks

# ---------- Parser ----------
# Where uploaded/cloned repositories are staged on disk
WORKSPACE_DIR=./workspace
MAX_REPO_SIZE_MB=500
PARSE_TIMEOUT_SECONDS=900

# ---------- LLM (chat / reasoning) ----------
# The backend reads LLM_PROVIDER and loads the matching implementation, so only
# the keys for the selected provider need to be filled.
#   anthropic  Claude, via the official SDK
#   stub       deterministic, offline, no key — what the test suite runs on
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# How hard the model works: low | medium | high | xhigh | max.
# This replaces the temperature knob — temperature, top_p and top_k are not
# parameters on current Claude models and sending one returns a 400.
LLM_EFFORT=high

LLM_TIMEOUT_SECONDS=120

# ---------- Embeddings (separate provider) ----------
# NOTE: Anthropic does not offer an embeddings endpoint. Chat and embeddings are
# independent choices in ARGUS — LLM_PROVIDER=anthropic still needs an embedding
# provider configured here.
#   openai  text-embedding-3-*, via the official SDK
#   hash    deterministic, offline, no key — not semantic; for tests only
EMBEDDING_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Must match the model above. Qdrant creates the collection with this width, so
# a mismatch rejects every write rather than failing at startup — the OpenAI
# provider checks the pair and refuses to construct if they disagree.
# text-embedding-3-small=1536, text-embedding-3-large=3072
EMBEDDING_DIMENSIONS=1536

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
