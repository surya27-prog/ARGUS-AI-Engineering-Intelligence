# ARGUS environment configuration
# Copy to .env and fill in. Never commit .env.

# ---------- App ----------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ---------- PostgreSQL ----------
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus_dev_password
POSTGRES_DB=argus
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://argus:argus_dev_password@localhost:5432/argus
# Seconds to wait for a Postgres connection before reporting it down
DB_CONNECT_TIMEOUT=5

# ---------- Neo4j ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=argus_dev_password
NEO4J_DATABASE=neo4j

# ---------- Qdrant ----------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=argus_code_chunks

# ---------- Parser ----------
# Where uploaded/cloned repositories are staged on disk
WORKSPACE_DIR=./workspace
MAX_REPO_SIZE_MB=500
PARSE_TIMEOUT_SECONDS=900

# ---------- LLM (chat / reasoning) ----------
# Provider is selected in Week 3. The backend reads LLM_PROVIDER and loads the
# matching implementation, so only one set of keys below needs to be filled.
# Supported values: anthropic | openai | ollama
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---------- Embeddings (separate provider) ----------
# NOTE: Anthropic does not offer an embeddings endpoint. Chat and embeddings are
# independent choices in ARGUS — LLM_PROVIDER=anthropic still needs an embedding
# provider configured here.
# Supported values: openai | ollama | local
EMBEDDING_PROVIDER=openai

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# sentence-transformers model, runs locally, no API cost
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Must match the model above; Qdrant collection is created with this size.
# text-embedding-3-small=1536, nomic-embed-text=768, bge-small-en-v1.5=384
EMBEDDING_DIMENSIONS=1536

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
