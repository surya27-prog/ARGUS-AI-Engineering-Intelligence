# ARGUS production configuration.
#
#     cp .env.prod.example .env.prod
#     docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Every value marked REQUIRED has no default in the compose file. Compose fails
# with a named error rather than starting the stack with a guessable password —
# a stack that boots with a known secret is worse than one that refuses to boot.
#
# Do not commit .env.prod. The .gitignore already covers `.env*`.

# ---------- REQUIRED: data store credentials ----------
POSTGRES_USER=argus
POSTGRES_PASSWORD=
POSTGRES_DB=argus
NEO4J_PASSWORD=

# ---------- REQUIRED: the two URLs, and why they differ ----------
# Both are browser-facing, and both are wrong if set to a service name.
#
# CORS_ORIGINS is the origin the browser sends, which is the *frontend's* URL —
# the API compares it against the Origin header.
CORS_ORIGINS=https://argus.example.com
#
# NEXT_PUBLIC_API_URL is compiled into the client bundle at build time, so it
# must be the URL the *browser* uses to reach the API. `http://api:8000` resolves
# inside the compose network and in no browser anywhere.
NEXT_PUBLIC_API_URL=https://api.argus.example.com

# ---------- Providers ----------
# Chat and embeddings are independent choices: Anthropic has no embeddings
# endpoint, so LLM_PROVIDER=anthropic still needs an embedding provider set.
# Leave both keys empty and the API still serves files, symbols, the graph,
# impact, risk and debt — only search and chat return 503.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the model above — the Qdrant collection is created with this size.
# text-embedding-3-small=1536, nomic-embed-text=768, bge-small-en-v1.5=384
EMBEDDING_DIMENSIONS=1536

# ---------- Published ports ----------
# Only these two are published. The data stores are reachable on the internal
# network only, which is the main difference from the development compose.
API_PORT=8000
WEB_PORT=3000

# ---------- Tuning ----------
LOG_LEVEL=INFO
MAX_REPO_SIZE_MB=500
HISTORY_DEPTH=500
QDRANT_COLLECTION=argus_code_chunks
# Neo4j sizing. Raise for repositories past ~100k symbols.
NEO4J_HEAP=1G
NEO4J_PAGECACHE=512m

# Refuse to clone from loopback and private addresses. Turn on only when
# pointing ARGUS at a git server on your own network — a server that fetches
# arbitrary internal addresses on request can be used to read them.
ALLOW_PRIVATE_GIT_HOSTS=false
