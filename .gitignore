# Environment
# Every env file, then the templates back. `.env.prod` in particular holds
# production secrets and is created by copying `.env.prod.example`, so a rule
# naming only `.env` and `.env.local` would have tracked it.
.env
.env.*
!.env.example
!.env.prod.example
!.env.local.example
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Node
node_modules/
.next/
out/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

